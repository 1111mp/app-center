{
  "name": "app-center",
  "version": "1.0.0",
  "description": "基于微前端架构的 Web 应用中心 🌈",
  "scripts": {
    "dev": "turbo dev",
    "dev:server": "turbo dev --filter=server",
    "dev:wrapper": "turbo dev --filter=wrapper",
    "dev:home": "turbo dev --filter=home",
    "dev:web": "turbo dev --filter=!server",
    "debug:server": "turbo debug --filter=server",
    "debug:home": "turbo debug --filter=home",
    "debug:developer-center": "turbo debug --filter=developer-center",
    "build": "turbo build",
    "build:wrapper": "turbo build --filter=wrapper",
    "build:deployer": "turbo build --filter=deployer",
    "build:release": "turbo build:release --filter=home --filter=developer-center",
    "clean": "pnpm clean:turbo && pnpm clean:lock && pnpm clean:node-modules && pnpm install",
    "clean:turbo": "turbo clean",
    "clean:node-modules": "rimraf node_modules",
    "clean:lock": "rimraf ./pnpm-lock.yaml",
    "format:check": "prettier --check ./**/**/src --cache",
    "format:write": "prettier --write ./**/**/src --cache"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@the1111mp/simple-store": "^1.0.1",
    "antd": "^5.23.1",
    "axios": "^1.7.9",
    "lodash": "^4.17.21",
    "lucide-react": "^0.473.0",
    "qiankun": "^2.10.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "https://github.com/1111mp/react-refresh-webpack-plugin.git",
    "@svgr/webpack": "^8.1.0",
    "@types/lodash": "^4.17.14",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/webpack": "^5.28.5",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.4.2",
    "query-string": "^7.1.3",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "terser-webpack-plugin": "^5.3.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "webpack": "^5.97.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpackbar": "^7.0.0"
  },
  "packageManager": "pnpm@10.0.0"
}
